# Copy to .env and fill in. Never commit .env.

# Telegram: create a bot with @BotFather, message it once, then run `python -m marv get-chat-id`
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# College football data (free): https://collegefootballdata.com/key
CFBD_API_KEY=

# Optional: multi-book consensus odds from https://the-odds-api.com (free tier = 500 credits/month,
# each sport per run costs 3 credits; running every sport daily needs a paid plan).
ODDS_API_KEY=
# Sportsbook whose prices Marv uses (Odds API key: bovada, draftkings, fanduel, ...). Default bovada.
# ODDS_BOOK=bovada

# Which sports to run (default: all). Options: cfb,nfl,nba,wnba,nhl,mlb,soccer
# SPORTS=nfl,nba,nhl,mlb,soccer,wnba,cfb

# Paper trading labels every card as tracked-not-bet. Turn off only after the record shows an edge.
PAPER_MODE=true
# Cards are only sent when they have a new qualified play; set true to also get "no plays" cards
SEND_EMPTY_CARDS=false

# SIMULATIONS=20000

# Calibration: how much weight the model gets vs. the market's implied score (0-1). Default 0.5.
# NFL_MODEL_WEIGHT=0.5

# Per-sport veto overrides: <SPORT>_<SETTING>, e.g.
# NBA_SPREAD_EDGE=0.05   MLB_TOTAL_EDGE=0.06   NHL_MIN_GAMES=10   NFL_ML_MAX=150
# Settings: SPREAD_EDGE TOTAL_EDGE ML_EDGE TRAP_SPREAD TRAP_TOTAL SPREAD_GAP TOTAL_GAP ML_PROB_GAP MIN_GAMES ML_MIN ML_MAX
