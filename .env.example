# Copy to .env and fill in. Never commit .env.

# Free key: https://collegefootballdata.com/key
CFBD_API_KEY=

# From @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Your chat id; run `python -m cfb_bot get-chat-id` after messaging your bot
TELEGRAM_CHAT_ID=

# Optional tuning (defaults shown)
# SIMULATIONS=20000
# SPREAD_EDGE=0.04           # min cover-probability edge over the -110 break-even
# BIG_SPREAD_EDGE=0.08       # required edge when |spread| >= 21
# HUGE_SPREAD_EDGE=0.10      # required edge when |spread| >= 28
# TOTAL_EDGE=0.05
# ML_EDGE=0.05
# TRAP_MOVE=2.5              # points the line moved against our side before veto
# GARBAGE_MARGIN=21          # lead entering Q4 that triggers the garbage-time dampener
# MAX_GAMES=30               # "marquee" games per slate (by combined team rating)
