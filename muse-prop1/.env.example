# Muse Prop1 replay does not read this file and does not need a key.
# Do not paste keys into chat. Leave these blank for log-only replay.
# LIVE_PROPS_SEND must be off. Unset is refused by replay and does not send.
LIVE_PROPS_SEND=off
# PROPLINE_API_KEY is not used by snapshot replay. A future single collector
# would need it, or Claude's ODDS_API_KEY, but not both engines polling.
# PropLine sport key basketball_ncaaw is NOT confirmed. Do not invent it.
# TELEGRAM_* are unused while sends are off.
PROPLINE_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
