[Unit]
Description=OANDA Master AI Shadow Campaign
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=moonrider1968
WorkingDirectory=/home/moonrider1968/oanda_master_alliance
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/moonrider1968/oanda_master_alliance/.venv/bin/python \
/home/moonrider1968/oanda_master_alliance/run_segment4b4.py
Restart=on-failure
RestartSec=15

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false

[Install]
WantedBy=multi-user.target
