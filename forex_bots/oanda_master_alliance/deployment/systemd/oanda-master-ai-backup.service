[Unit]
Description=OANDA Master AI Backup
After=network-online.target

[Service]
Type=oneshot
User=moonrider1968
Group=moonrider1968
WorkingDirectory=/home/moonrider1968/oanda_master_alliance
EnvironmentFile=/home/moonrider1968/oanda_master_alliance/deployment/environment/oanda-master-ai.env
EnvironmentFile=-/home/moonrider1968/oanda_master_alliance/.env
ExecStart=/home/moonrider1968/oanda_master_alliance/deployment/scripts/run_backup.sh
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/home/moonrider1968/oanda_master_alliance /home/moonrider1968/oanda_master_alliance_backups

StandardOutput=append:/home/moonrider1968/oanda_master_alliance/logs/segment4_backup_systemd.log
StandardError=append:/home/moonrider1968/oanda_master_alliance/logs/segment4_backup_systemd_error.log
