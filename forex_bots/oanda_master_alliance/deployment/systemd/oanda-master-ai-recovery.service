[Unit]
Description=OANDA Master AI Recovery Validation
After=network-online.target
Before=oanda-master-ai.service

[Service]
Type=oneshot
User=moonrider1968
Group=moonrider1968
WorkingDirectory=/home/moonrider1968/oanda_master_alliance
EnvironmentFile=/home/moonrider1968/oanda_master_alliance/deployment/environment/oanda-master-ai.env
EnvironmentFile=-/home/moonrider1968/oanda_master_alliance/.env
ExecStart=/home/moonrider1968/oanda_master_alliance/deployment/scripts/run_recovery.sh
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/home/moonrider1968/oanda_master_alliance /home/moonrider1968/oanda_master_alliance_backups

StandardOutput=append:/home/moonrider1968/oanda_master_alliance/logs/segment4_recovery_systemd.log
StandardError=append:/home/moonrider1968/oanda_master_alliance/logs/segment4_recovery_systemd_error.log
