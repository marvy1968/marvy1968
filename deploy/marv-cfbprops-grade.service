[Unit]
Description=Marv CFB props shadow grading (ESPN boxes; no credits, no Telegram)

[Service]
Type=oneshot
User=marvbot
WorkingDirectory=/opt/marv-bot
EnvironmentFile=-/opt/marv-bot/.env
ExecStart=/opt/marv-bot/.venv/bin/python -m marv.cfb_props_shadow --grade
TimeoutStartSec=1800
Nice=19
MemoryMax=1500M
