[Unit]
Description=Marv Soccer Predict Max - refresh ratings, paper-track fixtures, grade the paper record (never sends Telegram)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=marvbot
WorkingDirectory=/opt/marv-bot
EnvironmentFile=/opt/marv-bot/.env
ExecStart=/opt/marv-bot/.venv/bin/python -m marv soccer run
TimeoutStartSec=3600
Nice=10
