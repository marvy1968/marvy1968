[Unit]
Description=Marv FOREX practice runner (OANDA practice account only; separate from the Alpaca stock bot)
After=network-online.target

[Service]
User=marvbot
WorkingDirectory=/opt/marv-bot
EnvironmentFile=/opt/marv-bot/.env
ExecStart=/opt/marv-bot/.venv/bin/python -m fxbot paper
Restart=always
RestartSec=60

[Install]
WantedBy=multi-user.target
