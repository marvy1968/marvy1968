[Unit]
Description=Alpaca PAPER swing runner: open (Sector Top-Down, daily; deferred oversold entries at 10:00)
After=network-online.target

[Service]
Type=oneshot
User=marvbot
WorkingDirectory=/opt/marv-bot
EnvironmentFile=/opt/marv-bot/.env
ExecStart=/opt/marv-bot/.venv/bin/python -m alpacabot swing open
TimeoutStartSec=3600
