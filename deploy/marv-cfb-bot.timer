[Unit]
Description=Run Marv CFB Predict Max when college lines are posted and before kickoff

[Timer]
# Tuesday (openers settled), Friday, and Saturday morning, US Eastern time.
OnCalendar=Tue *-*-* 10:00:00 America/New_York
OnCalendar=Fri *-*-* 10:00:00 America/New_York
OnCalendar=Sat *-*-* 09:00:00 America/New_York
Persistent=true

[Install]
WantedBy=timers.target
