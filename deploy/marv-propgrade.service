[Unit]
Description=Marv prop grade v2 SHADOW - grade March_edge pregame NFL props 👍/neutral/👎 + summary (tracking only, never Telegram, never a filter)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=marvbot
WorkingDirectory=/opt/marv-bot
EnvironmentFile=-/opt/marv-bot/.env
ExecStart=/opt/marv-bot/.venv/bin/python -m marv.propgrade_shadow
TimeoutStartSec=1200
Nice=15
MemoryMax=1200M
