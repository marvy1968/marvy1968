[Unit]
Description=Alpaca PAPER trading loop (paper account only)
After=network-online.target

[Service]
User=marvbot
WorkingDirectory=/opt/marv-bot
EnvironmentFile=/opt/marv-bot/.env
ExecStart=/opt/marv-bot/.venv/bin/python -m alpacabot paper
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
