+# Marv bots (added 2026-11-04 at the owner's request: the card showed 0 trades while these traded). Their ledgers, read-only.
+MARV_STATE = Path("/opt/marv-bot/state")
+MARV_LEDGERS = {"VWAP sleeve": "alpaca_vwap", "Velez sleeve": "alpaca_velez", "Optimized Trend": "alpaca_trendopt"}
+
+
+def _jsonl(p: Path) -> list:
+    out = []
+    try:
+        for line in p.read_text().splitlines():
+            try:
+                out.append(json.loads(line))
+            except Exception:
+                pass
+    except Exception:
+        pass
+    return out
+
+
+def extract_marv_trades():
+    """Closed trades of the Marv day-trade sleeves (partials summed into one trade), the Marv swing bot and the Marv OANDA runner.
+    Dates are New York trading dates (the sleeves' own); missing / unreadable files are skipped."""
+    trades = []
+    for engine, d in MARV_LEDGERS.items():
+        open_ = {}
+        for r in _jsonl(MARV_STATE / d / "trades.jsonl"):
+            key = (r.get("symbol"), r.get("opened"))
+            acc = open_.setdefault(key, 0.0)
+            open_[key] = acc + float(r.get("pl") or 0.0)
+            if r.get("final"):
+                trades.append({"engine": engine, "date": str(r.get("date")), "time": str(r.get("closed", ""))[:19].replace("T", " "),
+                               "symbol": str(r.get("symbol")), "side": str(r.get("side", "")).upper(), "exit_px": float(r.get("exit") or 0),
+                               "pnl": round(open_.pop(key), 2), "reason": str(r.get("reason") or "")})
+    for r in _jsonl(MARV_STATE / "alpaca_swing" / "trades.jsonl"):
+        trades.append({"engine": "Swing (Marv)", "date": str(r.get("date")), "time": str(r.get("date")), "symbol": str(r.get("symbol")),
+                       "side": str(r.get("side", "")).upper(), "exit_px": float(r.get("exit") or 0), "pnl": float(r.get("pnl") or 0),
+                       "reason": str(r.get("reason") or "")})
+    for r in _jsonl(MARV_STATE / "fx_paper" / "trades.jsonl"):
+        if r.get("partial"):
+            continue
+        trades.append({"engine": "Forex (Marv runner)", "date": str(r.get("closed", ""))[:10], "time": str(r.get("closed", ""))[:19],
+                       "symbol": str(r.get("instrument")), "side": str(r.get("side", "")).upper(), "exit_px": float(r.get("exit") or 0),
+                       "pnl": float(r.get("pl") or 0), "reason": str(r.get("reason") or "")})
+    return trades
+
